# Normalize line endings: LF in the repo, native on checkout
* text=auto

# Windows scripts always check out with CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Visual Studio project files
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binary assets
*.wav binary
*.ttf binary
*.png binary
*.jpg binary
*.zip binary
*.pdf binary
