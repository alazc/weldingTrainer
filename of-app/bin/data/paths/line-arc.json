  // reversal that fought the trainee right where the line should flow into the arc.)
  // Geometry is the original full-size path scaled by 0.7 about its bounding-box
  // center (20,-100) — uniform scaling preserves the G1 continuity above.
  "name": "Line into arc",
  "primitives": [
    { "type": "linear", "p0": [6.0, -58.0], "p1": [6.0, -114.0] },
    {
      "type": "arc",
      "center":    [34.0, -114.0],
      "radius":    28.0,
      "start_rad": 3.14159265358979,
      "end_rad":   4.71238898038469
    }
  ]
