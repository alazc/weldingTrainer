  // pi/2 -> 3pi/2 (top->left->bottom); second 3pi/2 -> 5pi/2 closes back to the top.
  "name": "Small circle",
  "primitives": [
    {
      "type": "arc",
      "center":    [0.0, -110.0],
      "radius":    25.0,
      "start_rad": 1.5707963267949,
      "end_rad":   4.71238898038469
    },
    {
      "type": "arc",
      "center":    [0.0, -110.0],
      "radius":    25.0,
